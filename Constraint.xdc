create_clock -period 10 [get_ports clk]
set_property PACKAGE_PIN A20 [get_ports out_bit]
set_property PACKAGE_PIN A18 [get_ports out_valid]
set_property PACKAGE_PIN A16 [get_ports ready]
set_property PACKAGE_PIN A17 [get_ports rst_n]
set_property PACKAGE_PIN A15 [get_ports rx_bit0]
set_property PACKAGE_PIN A12 [get_ports rx_bit1]
set_property PACKAGE_PIN A13 [get_ports rx_valid]
set_property PACKAGE_PIN A21 [get_ports start]
set_property IOSTANDARD LVCMOS33 [get_ports clk]
set_property IOSTANDARD LVCMOS33 [get_ports out_bit]
set_property IOSTANDARD LVCMOS33 [get_ports ready]
set_property IOSTANDARD LVCMOS33 [get_ports out_valid]
set_property IOSTANDARD LVCMOS33 [get_ports rst_n]
set_property IOSTANDARD LVCMOS33 [get_ports rx_bit0]
set_property IOSTANDARD LVCMOS33 [get_ports rx_bit1]
set_property IOSTANDARD LVCMOS33 [get_ports rx_valid]
set_property IOSTANDARD LVCMOS33 [get_ports start]
set_property PACKAGE_PIN G21 [get_ports clk]
